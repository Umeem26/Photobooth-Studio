{
  "name": "vandebooth",
  "private": true,
  "version": "2.1.1",
  "description": "Van de Booth: kiosk photobooth (Electron + React UI + Java sidecar)",
  "workspaces": [
    "ui",
    "desktop"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run test --workspace ui && npm run test --workspace desktop",
    "e2e": "node scripts/build.mjs && playwright test",
    "package": "node scripts/package.mjs",
    "e2e:packaged": "playwright test --project packaged"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
